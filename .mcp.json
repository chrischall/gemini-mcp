{
  "mcpServers": {
    "gemini": {
      "command": "npx",
      "args": [
        "-y",
        "@chrischall/gemini-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GEMINI_IMAGE_MODEL": "${GEMINI_IMAGE_MODEL}",
        "GEMINI_OUTPUT_DIR": "${GEMINI_OUTPUT_DIR}",
        "GEMINI_INPUT_DIR": "${GEMINI_INPUT_DIR}"
      }
    }
  }
}
