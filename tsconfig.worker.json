{
  // Typecheck-only config for the WORKER half — the files tsconfig.json and
  // tsconfig.test.json deliberately exclude because they import
  // 'cloudflare:workers' / 'cloudflare:test', which resolve against the
  // Cloudflare type packages rather than @types/node.
  //
  // Without this nothing typechecks src/worker.ts at all: wrangler and the
  // vitest workers pool both transpile without checking types. Wired into
  // `npm run worker:test` (see package.json), mirroring how `npm test` runs
  // `npm run typecheck` first.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // `node` is here alongside the Workers types because wrangler.jsonc enables
    // `nodejs_compat`: the worker genuinely runs `node:path`/`node:fs`-importing
    // modules (client.ts → images.ts). Without it every shared `src/` module
    // this entrypoint pulls in fails to typecheck on its node: imports. Order
    // matters — the Workers types must win for the globals they both declare,
    // and skipLibCheck (inherited) absorbs the duplicate lib declarations.
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["worker-env.d.ts", "src/worker.ts", "tests/worker*.test.ts"],
  "exclude": []
}
