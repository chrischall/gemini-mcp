# Local secrets for `npm run worker:dev` (wrangler reads .dev.vars).
# Copy to `.dev.vars` — which is gitignored — and fill in real values.
# For a deployed Worker these are secrets, NOT vars:
#   wrangler secret put GEMINI_API_KEY

# NOT required by the deployed connector: each user supplies their own key on
# the login page and it is stored per-grant in OAUTH_KV. Kept here only as a
# convenience for `wrangler dev` / scratch scripts — nothing in the request path
# reads it. Google Generative Language API key (https://aistudio.google.com/apikey);
# sent upstream in the `x-goog-api-key` header — Gemini does NOT use Bearer auth.
GEMINI_API_KEY=

# Optional. Default image model override (bare id, e.g. gemini-3.1-flash-image).
GEMINI_IMAGE_MODEL=

# Optional. Upstream timeout in ms (default 60000; 120000 for 4K output).
GEMINI_TIMEOUT_MS=

# Optional. Public base URL of the MEDIA_BUCKET R2 bucket (no trailing slash),
# e.g. https://media.gemini.nullnet.app. Set it and generated media comes back as
# fetchable URLs. Unset, media is still stored but results report honest
# r2://gemini-connector-media/<key> refs instead of URLs that would 404.
MEDIA_PUBLIC_BASE_URL=

# Note: GEMINI_OUTPUT_DIR / GEMINI_INPUT_DIR do not apply to the Worker — it has
# no filesystem. Generated media goes to the MEDIA_BUCKET R2 binding instead, and
# there are no <image>.json sidecars.
