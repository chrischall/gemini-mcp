{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  // The Cloudflare Worker entrypoint is NOT part of the stdio build: it imports
  // 'cloudflare:workers' / 'agents' (workerd-only) and emitting dist/worker.js
  // would ship dead code in the npm package. wrangler compiles it separately
  // via wrangler.jsonc. tsconfig.test.json inherits this exclude, so `npm test`
  // does not typecheck worker sources either — `npm run worker:test` covers them.
  "exclude": ["src/worker.ts", "src/gemini-auth.ts"]
}
